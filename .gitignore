# Keep the project workspace's shared data, so Package.resolved (the pinned
# swift-argument-parser version) stays tracked for reproducible builds.
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!*.xcodeproj/project.xcworkspace/xcshareddata/
xcuserdata/

